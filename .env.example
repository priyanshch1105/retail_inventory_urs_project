# MongoDB Atlas or replica-set URI (transactions are required)
MONGODB_URI=mongodb://127.0.0.1:27017/retail_inventory?replicaSet=rs0

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h

PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001
TAX_RATE=0

# Set only for initial Admin provisioning, then unset
# ADMIN_NAME=Store Admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
